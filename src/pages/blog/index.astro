---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const CATEGORIES = ['writeups', 'exploits', 'research'] as const;
type Category = (typeof CATEGORIES)[number];

const grouped: Record<Category, typeof allPosts> = {
	writeups: allPosts.filter((p) => p.data.category === 'writeups'),
	exploits: allPosts.filter((p) => p.data.category === 'exploits'),
	research: allPosts.filter((p) => p.data.category === 'research'),
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 760px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			.section + .section {
				margin-top: 3.5em;
			}
			.section-header {
				display: flex;
				align-items: baseline;
				gap: 0.75em;
				border-bottom: 1px solid var(--border);
				padding-bottom: 0.5em;
				margin-bottom: 1em;
			}
			.section-header h2 {
				margin: 0;
				color: var(--accent);
				font-family: var(--font-mono);
				font-size: 1.5em;
				font-weight: 600;
			}
			.section-header h2::before {
				content: '> ';
				color: var(--fg-muted);
			}
			.section-header .count {
				color: var(--fg-muted);
				font-family: var(--font-mono);
				font-size: 0.875em;
			}
			ul {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			li {
				padding: 0.7em 0;
				border-bottom: 1px solid var(--border-muted);
			}
			li:last-child {
				border-bottom: none;
			}
			li a {
				display: flex;
				gap: 1.25em;
				align-items: baseline;
				border: none;
				color: var(--fg);
				text-decoration: none;
			}
			li a:hover {
				color: var(--accent);
				text-shadow: none;
			}
			li a:hover .title {
				text-decoration: underline;
			}
			.date {
				color: var(--fg-muted);
				font-family: var(--font-mono);
				font-size: 0.875em;
				min-width: 7em;
				flex-shrink: 0;
			}
			.title {
				flex: 1;
			}
			.empty {
				color: var(--fg-muted);
				font-family: var(--font-mono);
				font-size: 0.9em;
				padding: 0.7em 0;
			}
			.empty::before {
				content: '# ';
			}
			@media (max-width: 720px) {
				li a {
					flex-direction: column;
					gap: 0.2em;
				}
				.date {
					min-width: 0;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			{
				CATEGORIES.map((cat) => (
					<section class="section" id={cat}>
						<div class="section-header">
							<h2>{cat}</h2>
							<span class="count">{grouped[cat].length}</span>
						</div>
						{grouped[cat].length === 0 ? (
							<p class="empty">nothing here yet</p>
						) : (
							<ul>
								{grouped[cat].map((post) => (
									<li>
										<a href={`/blog/${post.id}/`}>
											<span class="date">
												<FormattedDate date={post.data.pubDate} />
											</span>
											<span class="title">{post.data.title}</span>
										</a>
									</li>
								))}
							</ul>
						)}
					</section>
				))
			}
		</main>
		<Footer />
	</body>
</html>
